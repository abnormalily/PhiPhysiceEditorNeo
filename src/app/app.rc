#include <windows.h>

IDI_ICON1 ICON "app.ico"
// asInvoker manifest: prevents Windows from elevating the editor and showing
// the unsigned-publisher UAC prompt at launch.
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Abnormalily"
            VALUE "FileDescription", "PhiPhysiceEditorNeo - physical note shape editor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PhiPhysiceEditorNeo"
            VALUE "LegalCopyright", "Copyright (C) 2026 Abnormalily"
            VALUE "OriginalFilename", "PhiPhysiceEditorNeo.exe"
            VALUE "ProductName", "PhiPhysiceEditorNeo"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
