# PhiPhysiceEditorNeo shape v2
# 设计坐标 Y 轴向上为正；每一行顶点遵循同一规则。
# &<变量名> <显示名> = <默认值>   新增一个可编辑变量
# $<节点编号> <X表达式> <Y表达式>  节点随变量偏移
yaxis up
name Flick
vertices 12
v -90.000 0.000
v -85.000 -9.000
v -12.000 -9.000
v 4.000 -18.000
v 4.000 -9.000
v 85.000 -9.000
v 90.000 0.000
v 85.000 9.000
v 12.000 9.000
v -4.000 18.000
v -4.000 9.000
v -85.000 9.000
density 1.15
friction 0.35
restitution 0.18
color 248 160 204
